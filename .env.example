# Copy to .env and fill in. Never commit .env.

# monitor = only ping Discord when a watched item fits (default, safe)
# claim   = buy it on your account and ping Discord
MODE=monitor

# Marketplaces to watch: bhopp, bloxymarket, or both (default). Switch any time with
# /market in Discord.
MARKETS=both

# Discord channel webhook for alerts: Channel settings > Integrations > Webhooks >
# New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
# Your Discord user ID: pinged on every buy, and the only user allowed to use the bot
# (Developer Mode > right-click yourself > Copy User ID)
DISCORD_MENTION_USER_ID=

# Discord bot for the slash commands (/watch, /limits, /balance, /status, /market).
# See README "From Discord". Keep this token secret.
DISCORD_BOT_TOKEN=
# Optional: your server ID, so the commands show up instantly.
DISCORD_GUILD_ID=

# BHOPP session for buying: localStorage "bhopp.token" on bhopp.com (starts with eyJ).
# Lasts 7 days; the bot warns before it expires. See README "Getting your sessions".
BHOPP_TOKEN=

# BloxyMarket session for buying: the full Cookie header value of a logged-in
# bloxymarket.com tab (DevTools > Network > a request to api.bloxymarket.com > cookie).
# Put it in double quotes here.
BLOXYMARKET_COOKIE=

# Seconds between polls of each site. 0 = poll again as soon as the last poll finishes.
POLL_INTERVAL_SECONDS=10

# BloxyMarket rate-limits by IP. Seconds between requests to it (1 got an IP blocked).
BLOXYMARKET_REQUEST_GAP_SECONDS=3

# Spending limits, in dollars. Empty or 0 = off. /limits in Discord overrides these.
# MAX_DAILY_SPEND caps the UTC day across both sites; MAX_CLAIM_PRICE caps any unit.
MAX_DAILY_SPEND=
MAX_CLAIM_PRICE=
# A buy takes every unit at the cheapest price your balance allows. This limits units
# per buy (empty or 0 = no limit).
MAX_CLAIM_QUANTITY=

# Buy items that are already listed when the bot starts (default: only react to
# changes while it runs).
ACT_ON_FIRST_SIGHT=false

# Only an UNCLEAR buy (timeout, no answer) pauses its site, until the bot sees on the
# site whether it went through, or this many minutes pass. 0 = until `mm2claimer resume`.
CLAIM_HOLD_TIMEOUT_MINUTES=30

# Optional quick watchlist instead of the Discord bot. Comma-separated:
#   Item<=5                     both sites, at $5 or less
#   Item@bhopp<=5               BHOPP only
#   Item@bloxymarket<=1 x3-10   BloxyMarket, only when 3+ fit, at most 10 per buy
# Claim mode refuses entries with no limit (MAX_CLAIM_PRICE counts).
WATCH=

LOG_LEVEL=INFO
# CONFIG_FILE=config.toml
# DATA_DIR=data
# LOG_DIR=logs
